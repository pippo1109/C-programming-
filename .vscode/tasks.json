{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Hello World",
            "type": "shell",
            "command": "cmake -S \"Hello World\" -B \"Hello World/build\" -G Ninja -DCMAKE_BUILD_TYPE=Debug",
            "problemMatcher": []
        },
        {
            "label": "Build Hello World",
            "type": "shell",
            "command": "cmake --build \"Hello World/build\"",
            "dependsOn": "Configure Hello World",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
